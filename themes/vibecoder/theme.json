{
  "id": "vibecoder",
  "name": "Vibecoder",
  "description": "A fresh web app starter, the one light theme: white rounded cards on cool slate, an indigo-to-violet accent, the waterfall a dark card set into the page.",
  "color_scheme": "light",
  "layout": { "rail": true, "ribbon_tilt_deg": 0 },
  "tokens": {
    "--bg": "#f1f5f9",
    "--bar": "#ffffff",
    "--border": "#e2e8f0",
    "--accent": "#4f46e5",
    "--text": "#1e293b",
    "--dim": "#475569",
    "--error": "#dc2626",
    "--ok": "#047857",
    "--user": "#b45309",
    "--c-frame": "#e2e8f0",
    "--c-source": "#4f46e5",
    "--c-action": "#4338ca",
    "--c-channel-1": "#6366f1",
    "--c-channel-2": "#8b5cf6",
    "--c-channel-3": "#0ea5e9",
    "--c-channel-4": "#10b981",
    "--c-channel-5": "#f59e0b",
    "--c-channel-6": "#ec4899",
    "--c-idle": "#94a3b8",
    "--c-speaking": "#7c3aed",
    "--wf-bg": "#0b1026",
    "--wf-select": "#a5b4fc",
    "--wf-select-alpha": "0.16",
    "--overlay-bg": "rgba(255, 255, 255, 0.92)",
    "--tint-span": "rgba(245, 158, 11, 0.08)",
    "--tint-outline": "rgba(165, 180, 252, 0.06)",
    "--tint-speaking": "rgba(139, 92, 246, 0.16)",
    "--label-bg": "rgba(255, 255, 255, 0.92)",
    "--map-mark": "#4f46e5",
    "--map-sel": "#db2777",
    "--map-dim": "#64748b",
    "--map-label-text": "#1e293b",
    "--scrim": "rgba(15, 23, 42, 0.32)",
    "--shadow": "rgba(15, 23, 42, 0.14)",
    "--shadow-strong": "rgba(15, 23, 42, 0.24)",
    "--font-ui": "\"Inter\", system-ui, \"DejaVu Sans\", sans-serif",
    "--font-mono": "\"JetBrains Mono\", ui-monospace, \"DejaVu Sans Mono\", monospace",
    "--rail-w": "150px",
    "--rail-thin-px": "5px",
    "--radius-bar": "10px",
    "--radius-elbow": "14px",
    "--bar-h-top": "50px",
    "--bar-h-bottom": "54px"
  },
  "ramp": [
    [0, [11, 16, 38]],
    [0.18, [26, 30, 86]],
    [0.38, [60, 50, 172]],
    [0.58, [124, 58, 237]],
    [0.78, [236, 72, 153]],
    [0.92, [251, 186, 210]],
    [1, [255, 255, 255]]
  ],
  "fonts": [
    { "family": "Inter", "file": "Inter-VF.ttf", "weight": "100 900" },
    { "family": "JetBrains Mono", "file": "JetBrainsMono-VF.ttf", "weight": "100 800" }
  ]
}
