{
  "id": "console",
  "name": "Console",
  "description": "Black ground, an elbowed frame, pill bars with dark text and a condensed face.",
  "color_scheme": "dark",
  "layout": { "rail": true, "ribbon_tilt_deg": -15 },
  "tokens": {
    "--bg": "#000",
    "--bar": "#0c0c10",
    "--border": "#3a3d48",
    "--accent": "#f3e3a0",
    "--text": "#e9e4d8",
    "--dim": "#8a8f9a",
    "--error": "#e05a5a",
    "--ok": "#7ee787",
    "--user": "#f7b98a",
    "--c-frame": "#f08c3c",
    "--c-source": "#b79ae6",
    "--c-action": "#f3e3a0",
    "--c-channel-1": "#6aa8e0",
    "--c-channel-2": "#f3e3a0",
    "--c-channel-3": "#b79ae6",
    "--c-channel-4": "#6fcfc4",
    "--c-channel-5": "#f7b98a",
    "--c-channel-6": "#f08c3c",
    "--c-idle": "#3a3d48",
    "--c-speaking": "#7ee787",
    "--font-ui": "\"Antonio\", \"DejaVu Sans Condensed\", \"Roboto Condensed\", \"Arial Narrow\", sans-serif",
    "--rail-w": "96px",
    "--radius-bar": "14px",
    "--radius-elbow": "22px"
  },
  "ramp": [[0, [0, 0, 48]], [0.35, [0, 90, 255]], [0.75, [255, 225, 0]], [1, [255, 255, 255]]],
  "fonts": [{ "family": "Antonio", "file": "Antonio-VF.ttf", "weight": "400 700" }]
}
