{
  "id": "plain",
  "name": "Plain",
  "description": "Dark slate panels, hairline borders, a monospace face and no frame.",
  "color_scheme": "dark",
  "layout": { "rail": false, "ribbon_tilt_deg": 0 },
  "tokens": {
    "--bg": "#0b0e14",
    "--bar": "#141923",
    "--border": "#2a3140",
    "--accent": "#5ec8ff",
    "--text": "#c9d1dc",
    "--dim": "#7a8496",
    "--error": "#ff6b6b",
    "--ok": "#7ee787",
    "--user": "#e6c07b",
    "--c-frame": "var(--border)",
    "--c-source": "var(--accent)",
    "--c-action": "var(--accent)",
    "--c-channel-1": "var(--accent)",
    "--c-channel-2": "var(--accent)",
    "--c-channel-3": "var(--accent)",
    "--c-channel-4": "var(--accent)",
    "--c-channel-5": "var(--accent)",
    "--c-channel-6": "var(--accent)",
    "--c-idle": "var(--dim)",
    "--c-speaking": "var(--ok)",
    "--wf-bg": "#000030",
    "--wf-select": "#ffffff",
    "--overlay-bg": "color-mix(in srgb, var(--bg) 78%, transparent)",
    "--tint-span": "rgba(255, 255, 255, 0.04)",
    "--tint-outline": "rgba(255, 255, 255, 0.03)",
    "--tint-speaking": "color-mix(in srgb, var(--ok) 8%, transparent)",
    "--label-bg": "rgba(0, 0, 0, 0.65)",
    "--map-mark": "#ff7a1a",
    "--map-sel": "#2aa1ff",
    "--map-dim": "#666",
    "--map-label-text": "#fff",
    "--scrim": "rgba(0, 0, 0, 0.55)",
    "--shadow": "rgba(0, 0, 0, 0.5)",
    "--shadow-strong": "rgba(0, 0, 0, 0.6)",
    "--font-ui": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace",
    "--font-mono": "ui-monospace, monospace",
    "--rail-w": "0px",
    "--rail-thin-px": "5px",
    "--radius-bar": "3px",
    "--radius-elbow": "0",
    "--axis-w": "64px",
    "--side-w": "360px",
    "--side-collapsed-w": "44px",
    "--bar-h-top": "34px",
    "--bar-h-bottom": "38px",
    "--bar-h": "var(--bar-h-top)"
  },
  "ramp": [[0, [0, 0, 48]], [0.35, [0, 90, 255]], [0.75, [255, 225, 0]], [1, [255, 255, 255]]]
}
