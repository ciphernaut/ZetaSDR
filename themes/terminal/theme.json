{
  "id": "terminal",
  "name": "Terminal",
  "description": "A text-mode screen: phosphor green on black, boxed panes with titles in the border, a block cursor.",
  "color_scheme": "dark",
  "layout": { "rail": true, "ribbon_tilt_deg": 0 },
  "tokens": {
    "--bg": "#000000",
    "--bar": "#020a03",
    "--border": "#1f7a35",
    "--accent": "#7dff8f",
    "--text": "#4dff6a",
    "--dim": "#2fa846",
    "--error": "#ffb000",
    "--ok": "#b6ffbe",
    "--user": "#d4ffd8",
    "--c-frame": "#1f7a35",
    "--c-source": "#4dff6a",
    "--c-action": "#4dff6a",
    "--c-channel-1": "#4dff6a",
    "--c-channel-2": "#c2ff4d",
    "--c-channel-3": "#2ee6b0",
    "--c-channel-4": "#e8ff9e",
    "--c-channel-5": "#7affd6",
    "--c-channel-6": "#9fd86a",
    "--c-idle": "#1a5c28",
    "--c-speaking": "#e6ffe8",
    "--wf-bg": "#000000",
    "--wf-select": "#4dff6a",
    "--wf-select-alpha": "0.10",
    "--overlay-bg": "color-mix(in srgb, var(--bg) 86%, transparent)",
    "--tint-span": "rgba(255, 176, 0, 0.05)",
    "--tint-outline": "rgba(77, 255, 106, 0.03)",
    "--tint-speaking": "rgba(230, 255, 232, 0.08)",
    "--label-bg": "rgba(0, 0, 0, 0.82)",
    "--map-mark": "#4dff6a",
    "--map-sel": "#ffb000",
    "--map-dim": "#2fa846",
    "--map-label-text": "#b6ffbe",
    "--scrim": "rgba(0, 0, 0, 0.7)",
    "--shadow": "rgba(0, 0, 0, 0.7)",
    "--shadow-strong": "rgba(0, 0, 0, 0.8)",
    "--font-ui": "\"JetBrains Mono\", ui-monospace, \"DejaVu Sans Mono\", monospace",
    "--font-mono": "\"JetBrains Mono\", ui-monospace, monospace",
    "--rail-w": "156px",
    "--rail-thin-px": "5px",
    "--radius-bar": "0px",
    "--radius-elbow": "0px"
  },
  "ramp": [
    [0, [0, 0, 0]],
    [0.12, [0, 40, 10]],
    [0.35, [0, 110, 30]],
    [0.65, [60, 230, 90]],
    [0.85, [150, 255, 160]],
    [1, [235, 255, 235]]
  ],
  "fonts": [
    { "family": "JetBrains Mono", "file": "JetBrainsMono-VF.ttf", "weight": "100 800" }
  ]
}
