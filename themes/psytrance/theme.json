{
  "id": "psytrance",
  "name": "Psytrance",
  "description": "Blacklight on deep indigo: fluorescent pink, lime, orange and UV cyan, soft uneven panels with gradient borders.",
  "color_scheme": "dark",
  "layout": { "rail": true, "ribbon_tilt_deg": 8 },
  "tokens": {
    "--bg": "#110a2b",
    "--bar": "#1a1040",
    "--border": "#4a3a8c",
    "--accent": "#ff4fc8",
    "--text": "#f4ecff",
    "--dim": "#a596d8",
    "--error": "#ff9a2e",
    "--ok": "#b8ff3c",
    "--user": "#5cf2ff",
    "--c-frame": "#ff4fc8",
    "--c-source": "#5cf2ff",
    "--c-action": "#5cf2ff",
    "--c-channel-1": "#ff4fc8",
    "--c-channel-2": "#b8ff3c",
    "--c-channel-3": "#ff9a2e",
    "--c-channel-4": "#5cf2ff",
    "--c-channel-5": "#c38bff",
    "--c-channel-6": "#fff24a",
    "--c-idle": "#4d4183",
    "--c-speaking": "#b8ff3c",
    "--wf-bg": "#07031a",
    "--wf-select": "#ff4fc8",
    "--wf-select-alpha": "0.14",
    "--overlay-bg": "color-mix(in srgb, var(--bg) 82%, transparent)",
    "--tint-span": "rgba(255, 154, 46, 0.06)",
    "--tint-outline": "rgba(92, 242, 255, 0.04)",
    "--tint-speaking": "rgba(184, 255, 60, 0.10)",
    "--label-bg": "rgba(17, 10, 43, 0.82)",
    "--map-mark": "#ff4fc8",
    "--map-sel": "#b8ff3c",
    "--map-dim": "#a596d8",
    "--map-label-text": "#f4ecff",
    "--scrim": "rgba(10, 4, 30, 0.72)",
    "--shadow": "rgba(255, 79, 200, 0.22)",
    "--shadow-strong": "rgba(92, 242, 255, 0.22)",
    "--font-ui": "\"Nunito\", system-ui, \"DejaVu Sans\", sans-serif",
    "--font-mono": "\"Nunito\", system-ui, \"DejaVu Sans\", sans-serif",
    "--rail-w": "150px",
    "--rail-thin-px": "5px",
    "--radius-bar": "10px",
    "--radius-elbow": "14px"
  },
  "ramp": [
    [0, [16, 6, 48]],
    [0.12, [70, 22, 156]],
    [0.26, [96, 24, 176]],
    [0.38, [196, 40, 200]],
    [0.5, [255, 64, 150]],
    [0.62, [255, 150, 40]],
    [0.74, [240, 240, 60]],
    [0.84, [150, 255, 80]],
    [0.93, [80, 230, 255]],
    [1, [255, 255, 255]]
  ],
  "fonts": [
    { "family": "Comfortaa", "file": "Comfortaa-VF.ttf", "weight": "300 700" },
    { "family": "Nunito", "file": "Nunito-VF.ttf", "weight": "200 1000" }
  ]
}
