{
  "id": "cyberpunk",
  "name": "Cyberpunk",
  "description": "Near-black ground, magenta and cyan neon outlines, chamfered corners and a techno face.",
  "color_scheme": "dark",
  "layout": { "rail": true, "ribbon_tilt_deg": -8 },
  "tokens": {
    "--bg": "#06070e",
    "--bar": "#0b0e1c",
    "--border": "#2b3160",
    "--accent": "#ff2bd6",
    "--text": "#dce6ff",
    "--dim": "#8189b4",
    "--error": "#eaff3c",
    "--ok": "#00f0ff",
    "--user": "#ff9cf0",
    "--c-frame": "#ff2bd6",
    "--c-source": "#00f0ff",
    "--c-action": "#00f0ff",
    "--c-channel-1": "#ff2bd6",
    "--c-channel-2": "#2bb4ff",
    "--c-channel-3": "#b07cff",
    "--c-channel-4": "#3dffc5",
    "--c-channel-5": "#ff5fa2",
    "--c-channel-6": "#6f8cff",
    "--c-idle": "#3a4170",
    "--c-speaking": "#00f0ff",
    "--wf-bg": "#08001a",
    "--wf-select": "#ff2bd6",
    "--wf-select-alpha": "0.12",
    "--overlay-bg": "color-mix(in srgb, var(--bg) 84%, transparent)",
    "--tint-span": "rgba(234, 255, 60, 0.05)",
    "--tint-outline": "rgba(0, 240, 255, 0.035)",
    "--tint-speaking": "rgba(0, 240, 255, 0.10)",
    "--label-bg": "rgba(6, 7, 14, 0.8)",
    "--map-mark": "#ff2bd6",
    "--map-sel": "#00f0ff",
    "--map-dim": "#8189b4",
    "--map-label-text": "#dce6ff",
    "--scrim": "rgba(4, 2, 18, 0.72)",
    "--shadow": "rgba(255, 43, 214, 0.22)",
    "--shadow-strong": "rgba(0, 240, 255, 0.22)",
    "--font-ui": "\"Share Tech Mono\", ui-monospace, \"DejaVu Sans Mono\", monospace",
    "--font-mono": "\"Share Tech Mono\", ui-monospace, monospace",
    "--rail-w": "148px",
    "--rail-thin-px": "5px",
    "--radius-bar": "0px",
    "--radius-elbow": "0px"
  },
  "ramp": [
    [0, [8, 0, 26]],
    [0.3, [76, 0, 128]],
    [0.55, [232, 32, 200]],
    [0.8, [0, 232, 255]],
    [1, [255, 255, 255]]
  ],
  "fonts": [
    { "family": "Orbitron", "file": "Orbitron-VF.ttf", "weight": "400 900" },
    { "family": "Share Tech Mono", "file": "ShareTechMono-Regular.ttf", "weight": "400" }
  ]
}
