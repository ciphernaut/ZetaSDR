# /etc/zetasdr/env (mode 0600). Read by systemd; no quoting or shell expansion.
# Serve secret: 16+ characters. Replace this placeholder before starting the service.
ZETA_SECRET=change-me-to-16-plus-chars

# Source flags passed to zeta before `serve`. Empty means no sources.
ZETA_SOURCES=
# Example: one Kiwi receiver with id "kiwi1" (password in the matching variable).
#ZETA_SOURCES=--source-kiwi kiwi1=kiwi.local:8073
#ZETA_KIWI_PASSWORD_KIWI1=changeme
