# /etc/zetasdr/env (mode 0600). Read by systemd; no quoting or shell expansion.
# Serve secret: REQUIRED, 16+ random chars, e.g. the output of: openssl rand -hex 16
# The service refuses to start while this is empty.
ZETA_SECRET=

# Source flags passed to zeta before `serve`. Empty means no sources.
ZETA_SOURCES=
# Example: one Kiwi receiver with id "kiwi" (password in the matching variable).
#ZETA_SOURCES=--source-kiwi kiwi=kiwi.local:8073
#ZETA_KIWI_PASSWORD_KIWI=changeme
