[Unit]
Description=ZetaSDR node (zeta serve)
After=network-online.target
Wants=network-online.target

[Service]
User=zetasdr
EnvironmentFile=/etc/zetasdr/env
# serve binds LAN addresses only; 0.0.0.0 (unspecified) passes the LAN check.
# ZETA_SOURCES is deliberately unquoted so it splits into --source-* arguments.
ExecStart=/usr/local/bin/zeta --state-dir /var/lib/zetasdr $ZETA_SOURCES serve --listen 0.0.0.0:7979
Restart=on-failure
RestartSec=3
MemoryMax=1G
Nice=-5
StateDirectory=zetasdr

[Install]
WantedBy=multi-user.target
