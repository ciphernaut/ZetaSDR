{
  "id": "m20_decode",
  "name": "Meteomodem M20 radiosonde",
  "family": "weather_science",
  "band": {"bandwidth_hz": 12500, "centers_hz": [], "range_hz": [400050000, 406000000], "min_hz": null},
  "modulation": ["fsk", "fm"],
  "label": "M20",
  "protocol": "m20",
  "decoder": {
    "kind": "program",
    "programs": ["m20mod"],
    "args": ["--json"],
    "demod": {"kind": "nbfm", "deviation_hz": 5000, "audio_rate_hz": 48000},
    "input": {"stream": "audio", "format": "s16", "rate_hz": 48000, "via": "stdin", "container": "wav"},
    "output": {"via": "stdout", "port": null, "parser": "json_lines"},
    "install": {"debian": "sonde-decoders", "url": "https://github.com/rs1729/RS"}
  },
  "event": {
    "schema": {
      "type": "object",
      "properties": {
        "frame": {"type": "integer"},
        "id": {"type": "string"},
        "datetime": {"type": "string"},
        "lat": {"type": "number"},
        "lon": {"type": "number"},
        "alt": {"type": "number"},
        "vel_h": {"type": "number"},
        "heading": {"type": "number"},
        "vel_v": {"type": "number"},
        "sats": {"type": "integer"},
        "bt": {"type": "integer"},
        "batt": {"type": "number"}
      }
    },
    "summary": "{id} {lat?:.4},{lon?:.4} {alt?:.0} m {vel_v?:+.1} m/s"
  },
  "position": {"lat": "lat", "lon": "lon", "alt_m": "alt"},
  "time": "datetime",
  "identify": {
    "proof": "event",
    "min_events": 1,
    "dwell_ms": 5000,
    "min_span_ms": 1000,
    "quick": null,
    "priority": 0
  },
  "catalogue": ["m20-radiosonde"],
  "test": {"kind": "synth", "family": "m20", "serial": "M20-611-2-01234", "lat": -27.3842, "lon": 153.1175, "alt_m": 5000, "vel_v": 4.5, "frames": 6, "snr_db": 20, "offset_hz": 0, "ppm": 0, "expect": {"id": "M20-611-2-01234", "lat": {"near": -27.3842, "within": 0.001}}, "within_ms": 8000},
  "notes": "Meteomodem M20 radiosondes anywhere in 400.05-406 MHz; start the job on the measured centre. One job decodes one sonde. m20mod 1.8.1 (sonde-decoders) takes --json only: it has no --ecc or --crc (an unknown option is read as the input file, error: open).",
  "subject": {
    "key": "id",
    "name": "sondes",
    "waterfall": "fold",
    "columns": [
      {
        "field": "alt",
        "label": "Altitude",
        "unit": "m"
      },
      {
        "field": "vel_v",
        "label": "Vertical speed",
        "unit": "m_s"
      }
    ],
    "heading": "heading",
    "label": null,
    "track_points": 500,
    "track_min_m": 100
  }
}
