{
  "id": "acars_decode",
  "name": "ACARS aircraft messages",
  "family": "aviation",
  "band": {
    "bandwidth_hz": 10000,
    "centers_hz": [131550000, 131725000, 131825000, 130025000, 130450000, 131125000, 131450000]
  },
  "modulation": ["am"],
  "label": "ACARS",
  "protocol": "acars",
  "decoder": {
    "kind": "graph",
    "nodes": [
      {
        "id": "channel",
        "kind": "channel",
        "params": {
          "center_hz": "$center_hz",
          "bandwidth_hz": "$bandwidth_hz",
          "out_rate_hz": "$out_rate_hz"
        }
      },
      {
        "id": "decode",
        "kind": "acars_decode",
        "params": {}
      }
    ],
    "edges": [
      { "from": "channel", "to": "decode", "kind": "iq" }
    ]
  },
  "event": {
    "schema": {
      "type": "object",
      "properties": {
        "protocol": { "type": "string" },
        "mode": { "type": "string" },
        "reg": { "type": "string" },
        "ack": { "type": ["string", "null"] },
        "label": { "type": "string" },
        "block_id": { "type": ["string", "null"] },
        "msg_no": { "type": ["string", "null"] },
        "flight": { "type": ["string", "null"] },
        "text": { "type": "string" },
        "crc_ok": { "type": "boolean" },
        "downlink": { "type": "boolean" },
        "lat": { "type": ["number", "null"] },
        "lon": { "type": ["number", "null"] },
        "alt_ft": { "type": ["integer", "null"] }
      }
    },
    "summary": "{reg} {label}: {text?}"
  },
  "identify": {
    "proof": "event",
    "min_events": 1,
    "dwell_ms": 10000,
    "min_span_ms": 1000,
    "quick": "acars"
  },
  "catalogue": ["acars", "aircraft-communications-addressing-and-reporting-system-acar"],
  "test": {
    "kind": "synth",
    "family": "acars",
    "reg": "VH-ZET",
    "label": "H1",
    "block_id": "2",
    "text": "M01AZET001#M1BPOSS27231E153071,ALPHA,025131,165,BRAVO,025351,CHARL,M9,252035,168",
    "expect": {
      "reg": "VH-ZET",
      "label": "H1",
      "flight": "ZET001",
      "lat": {"near": -27.385, "within": 0.001},
      "lon": {"near": 153.1183, "within": 0.001},
      "alt_ft": 16500
    },
    "within_ms": 5000
  },
  "position": { "lat": "lat", "lon": "lon", "alt_m": "alt_ft", "alt_unit": "ft" },
  "derive": [
    {
      "when": { "downlink": true },
      "from": "text",
      "extract": "acars_position",
      "into": { "lat": "lat", "lon": "lon", "alt_ft": "alt_ft" }
    }
  ],
  "notes": "A downlink (a digit block id, downlink true) whose text is a position report (labels H1, 80, 16, 3L, QQ) carries lat, lon, sometimes alt_ft, and a position: the aircraft's own report, typically a few minutes old by the time it is relayed. Uplinks are never parsed.",
  "subject": {
    "key": "reg",
    "name": "aircraft",
    "waterfall": "summary",
    "columns": [
      {
        "field": "flight",
        "label": "Flight",
        "unit": null
      },
      {
        "field": "label",
        "label": "Label",
        "unit": null
      },
      {
        "field": "text",
        "label": "Text",
        "unit": null
      }
    ],
    "heading": null,
    "label": "flight",
    "merge": ["reg"],
    "track_points": 100,
    "track_min_m": 1000
  }
}
