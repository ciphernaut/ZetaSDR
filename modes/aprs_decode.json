{
  "id": "aprs_decode",
  "name": "APRS packet radio",
  "family": "amateur_digital",
  "band": {
    "bandwidth_hz": 12500,
    "centers_hz": [144800000, 144390000, 145175000],
    "range_hz": [144383750, 145181250]
  },
  "modulation": ["fm", "fsk"],
  "label": "APRS",
  "protocol": "aprs",
  "decoder": {
    "kind": "graph",
    "nodes": [
      {
        "id": "channel",
        "kind": "channel",
        "params": {
          "center_hz": "$center_hz",
          "bandwidth_hz": "$bandwidth_hz",
          "out_rate_hz": "$out_rate_hz"
        }
      },
      {
        "id": "demod",
        "kind": "nbfm_demod",
        "params": {
          "deviation_hz": 3000,
          "audio_rate_hz": 48000,
          "squelch_db": null,
          "squelch": false
        }
      },
      {
        "id": "decode",
        "kind": "aprs_decode",
        "params": {}
      }
    ],
    "edges": [
      { "from": "channel", "to": "demod", "kind": "iq" },
      { "from": "demod", "to": "decode", "kind": "audio" }
    ]
  },
  "event": {
    "schema": {
      "type": "object",
      "properties": {
        "protocol": { "type": "string" },
        "src": { "type": "string" },
        "dst": { "type": "string" },
        "path": { "type": "array", "items": { "type": "string" } },
        "info": { "type": "string" },
        "info_hex": { "type": "string" },
        "fcs_ok": { "type": "boolean" },
        "lat": { "type": ["number", "null"] },
        "lon": { "type": ["number", "null"] },
        "alt_m": { "type": ["number", "null"] },
        "course_deg": { "type": ["number", "null"] },
        "speed_kt": { "type": ["number", "null"] },
        "symbol": { "type": ["string", "null"] },
        "comment": { "type": ["string", "null"] },
        "data_type": {
          "type": "string",
          "enum": ["position", "mic_e", "object", "item", "message", "status", "telemetry", "weather", "other"]
        },
        "object": { "type": ["string", "null"] }
      }
    },
    "summary": "{src} > {dst}: {info}"
  },
  "position": {"lat": "lat", "lon": "lon", "alt_m": "alt_m"},
  "identify": {
    "proof": "field",
    "field": "fcs_ok",
    "min_events": 1,
    "dwell_ms": 5000,
    "min_span_ms": 1000,
    "quick": "aprs"
  },
  "catalogue": ["aprs", "automatic-packet-reporting-system-aprs"],
  "test": {
    "kind": "synth",
    "family": "aprs",
    "src": "VK3ABC",
    "dst": "APRS",
    "info": "!2723.05S/15307.05E>ZetaSDR",
    "echo": {"delay_us": 100, "gain_db": -6},
    "expect": {
      "protocol": "aprs",
      "src": "VK3ABC",
      "fcs_ok": true,
      "lat": {"near": -27.3842, "within": 0.0001},
      "lon": {"near": 153.1175, "within": 0.0001}
    },
    "within_ms": 5000
  },
  "notes": "APRS at 145 175 000 Hz in AU, 144 800 000 Hz in EU, 144 390 000 Hz in the US, 12 500 Hz band (identify tries it only from half a channel below the lowest centre to half a channel above the highest, its band.range_hz); one job hears every station on the channel. Positions in the three common formats (uncompressed, compressed, Mic-E) land on the map; objects and items are named, not placed.",
  "subject": {
    "key": "src",
    "name": "stations",
    "waterfall": "summary",
    "columns": [
      {
        "field": "dst",
        "label": "Destination",
        "unit": null
      },
      {
        "field": "info",
        "label": "Info",
        "unit": null
      }
    ],
    "heading": "course_deg",
    "label": null,
    "track_points": 100,
    "track_min_m": 50,
    "identity": {
      "field": "src",
      "register": "callsign",
      "strip": "ssid"
    }
  }
}
