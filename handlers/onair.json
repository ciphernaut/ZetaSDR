      "input": { "stream": "iq", "format": "cs16", "rate_hz": 250000, "via": "stdin" },
      "output": {
        "via": "stdout",
        "parser": "json_lines",
        "fields": {
          "icao": "/icao",
          "addr_type": "/addr_type",
          "dst": "/dst",
          "frame_type": "/frame"
        }
      },
      "extra": { "proto": "/proto" }
    },
