      "input": { "stream": "iq", "format": "cs16", "rate_hz": 250000, "via": "stdin" },
      "output": {
        "via": "stdout",
        "parser": "json_lines",
        "fields": {
          "mmsi": "/mmsi",
          "msg_type": "/msg_type",
          "channel": "/channel",
          "repeat": "/repeat",
          "nmea": "/nmea",
          "lat": "/lat",
          "lon": "/lon",
          "sog_kt": "/sog_kt",
