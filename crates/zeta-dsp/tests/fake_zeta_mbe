#!/bin/sh
# A stand-in for `zeta-mbe` in the voice stages' tests: for every frame on stdin (184 bytes
# for P25's `imbe7200x4400`, 96 for DMR's `ambe3600x2450`) it writes 160 16-bit samples
# (320 bytes) to stdout, every sample the same level, n * 257 for the n-th run beside the
# link (each byte n), so a test can tell which run a stream's speech came from. The tests
# run it through a link in a temporary directory, so "$0" is that link: each run takes its
# number by making "$0.run<n>" (made at once, so two runs started together differ), appends
# `start` to "$0.log", and `eof` when its input ends (it then exits 0). When "$0.die"
# exists, this run removes it and exits 1 after 10 frames. The stage starts it with an
# empty environment, so the PATH is its own.
PATH=/usr/bin:/bin
case "$1" in
    ambe3600x2450) bytes=96 ;;
    *) bytes=184 ;;
esac
n=1
until mkdir "$0.run$n" 2>/dev/null; do
    n=$((n + 1))
done
echo start >> "$0.log"
level=$(printf '\\%03o' "$n")
left=-1
if [ -e "$0.die" ]; then
    rm -f "$0.die"
    left=10
fi
while [ "$left" -ne 0 ]; do
    got=$(dd bs="$bytes" count=1 iflag=fullblock 2>/dev/null | wc -c)
    if [ "$got" -eq 0 ]; then
        echo eof >> "$0.log"
        exit 0
    fi
    head -c 320 /dev/zero | tr '\000' "$level"
    left=$((left - 1))
done
exit 1
